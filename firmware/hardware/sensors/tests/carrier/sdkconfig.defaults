CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_XTAL_FREQ_40=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_UNITY_ENABLE_IDF_TEST_RUNNER=y
CONFIG_UNITY_ENABLE_64BIT=y
CONFIG_CURA_SOIL_0_GPIO=1
CONFIG_CURA_SOIL_1_GPIO=2
CONFIG_CURA_SENSOR_POWER_GATE_GPIO=44
CONFIG_CURA_DS18B20_GPIO=4
CONFIG_CURA_I2C_SDA_GPIO=5
CONFIG_CURA_I2C_SCL_GPIO=6
CONFIG_CURA_SENSOR_POWER_STABILIZATION_MS=200
CONFIG_CURA_DS18B20_0_ROM="0000000000000000"
CONFIG_CURA_DS18B20_1_ROM="0000000000000000"

# D7/GPIO44 is the sensor gate; UART0 RX must never own it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_UNICORE=y
# CONFIG_SPIRAM is not set
