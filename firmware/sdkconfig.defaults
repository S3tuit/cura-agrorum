# Partitions 
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Crystal freq
CONFIG_XTAL_FREQ_40=y
CONFIG_XTAL_FREQ=40

# Use the internal RTC slow clock; sleep interval accuracy needs board checks.
CONFIG_RTC_CLK_SRC_INT_RC=y

# Storage records do not use filesystem modification timestamps.
# CONFIG_LITTLEFS_USE_MTIME is not set

# Fixed XIAO ESP32S3/Wio B2B wiring (HARDWARE.md).
CONFIG_CURA_I2C_SDA_GPIO=5
CONFIG_CURA_I2C_SCL_GPIO=6
CONFIG_CURA_SX1262_SCLK_GPIO=7
CONFIG_CURA_SX1262_MOSI_GPIO=9
CONFIG_CURA_SX1262_MISO_GPIO=8
CONFIG_CURA_SX1262_CS_GPIO=41
CONFIG_CURA_SX1262_RESET_GPIO=42
CONFIG_CURA_SX1262_BUSY_GPIO=40
CONFIG_CURA_SX1262_DIO1_GPIO=39

# Nested LittleFS persistence exhausted the 3584-byte main-task default.
# Keep production's stack large enough for the real wake/backlog call path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_CURA_SOIL_0_GPIO=1
CONFIG_CURA_SOIL_1_GPIO=2
CONFIG_CURA_SENSOR_POWER_GATE_GPIO=44
CONFIG_CURA_DS18B20_GPIO=4
CONFIG_CURA_SX1262_RF_ENABLE_GPIO=38

# D7/GPIO44 is the sensor gate; UART0 RX must never own it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_UNICORE=y
# CONFIG_SPIRAM is not set
