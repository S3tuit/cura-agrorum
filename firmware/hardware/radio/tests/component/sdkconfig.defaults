CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_XTAL_FREQ_40=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_UNITY_ENABLE_64BIT=y
CONFIG_CURA_SX1262_SCLK_GPIO=7
CONFIG_CURA_SX1262_MOSI_GPIO=9
CONFIG_CURA_SX1262_MISO_GPIO=8
CONFIG_CURA_SX1262_CS_GPIO=41
CONFIG_CURA_SX1262_RESET_GPIO=42
CONFIG_CURA_SX1262_BUSY_GPIO=40
CONFIG_CURA_SX1262_DIO1_GPIO=39
CONFIG_CURA_SOIL_0_GPIO=1
CONFIG_CURA_SOIL_1_GPIO=2
CONFIG_CURA_SENSOR_POWER_GATE_GPIO=44
CONFIG_CURA_DS18B20_GPIO=4
CONFIG_CURA_I2C_SDA_GPIO=5
CONFIG_CURA_I2C_SCL_GPIO=6
CONFIG_CURA_SX1262_RF_ENABLE_GPIO=38

# D7/GPIO44 is the sensor gate; UART0 RX must never own it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_UNICORE=y
# CONFIG_SPIRAM is not set
