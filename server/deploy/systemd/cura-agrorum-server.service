[Unit]
Description=Cura Agrorum gateway server
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/cura-agrorum/server
ExecStart=/opt/cura-agrorum/server/.venv/bin/python -m cura_server --host 0.0.0.0 --port 18032
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
