# Partitions 
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# Crystal freq
CONFIG_XTAL_FREQ_40=y
CONFIG_XTAL_FREQ=40
CONFIG_ESP32_XTAL_FREQ_40=y
CONFIG_ESP32_XTAL_FREQ=40

# Field hotspot defaults
CONFIG_ESP_WIFI_SSID="cura-field"
CONFIG_ESP_WIFI_PASSWORD="cura-field-password"
CONFIG_CURA_GATEWAY_IPV4_ADDR="10.42.0.1"
CONFIG_CURA_GATEWAY_PORT=18032
CONFIG_CURA_SYNC_EVERY_N_BOOTS=10
CONFIG_CURA_WIFI_CONNECT_TIMEOUT_MS=8000

# Use the internal 8 MHz oscillator for v0 since we need better logs at the
# cost of more power used
CONFIG_RTC_CLK_SRC_INT_8MD256=y
