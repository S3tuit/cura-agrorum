# Validate resolved values, including stale sdkconfig overrides. Kconfig ranges
# alone cannot express the ROM/address and shared-wiring constraints.
foreach(slot RANGE 0 1)
    set(analog "${CONFIG_CURA_SEN0193_${slot}}")
    set(address "${CONFIG_CURA_SEN0600_${slot}}")
    set(rom "${CONFIG_CURA_DS18B20_${slot}_ROM}")
    if(NOT analog MATCHES "^[01]$" OR NOT address MATCHES "^[0-9]+$" OR
       address GREATER 254)
        message(FATAL_ERROR "Sensor slot ${slot}: SEN0193 must be 0/1 and SEN0600 must be 0..254")
    endif()
    string(LENGTH "${rom}" rom_length)
    if(analog)
        if(NOT rom_length EQUAL 16 OR NOT rom MATCHES "^[0-9a-fA-F]+$" OR
           rom STREQUAL "0000000000000000")
            message(FATAL_ERROR "SEN0193 slot ${slot} requires a nonzero 16-hex-digit DS18B20 ROM")
        endif()
        if(CONFIG_CURA_SEN0600_0 OR CONFIG_CURA_SEN0600_1)
            message(FATAL_ERROR "SEN0193 and SEN0600 wiring cannot be combined")
        endif()
    elseif(NOT rom STREQUAL "")
        message(FATAL_ERROR "Disabled SEN0193 slot ${slot} requires an empty DS18B20 ROM")
    endif()
endforeach()
if(NOT CONFIG_CURA_SEN0193_0 AND NOT CONFIG_CURA_SEN0600_0)
    message(FATAL_ERROR "Soil slot 0 must be selected")
endif()
if(CONFIG_CURA_SEN0600_0 AND CONFIG_CURA_SEN0600_1 AND
   CONFIG_CURA_SEN0600_0 EQUAL CONFIG_CURA_SEN0600_1)
    message(FATAL_ERROR "Enabled SEN0600 addresses must differ")
endif()
string(TOLOWER "${CONFIG_CURA_DS18B20_0_ROM}" rom0)
string(TOLOWER "${CONFIG_CURA_DS18B20_1_ROM}" rom1)
if(CONFIG_CURA_SEN0193_0 AND CONFIG_CURA_SEN0193_1 AND rom0 STREQUAL rom1)
    message(FATAL_ERROR "Enabled DS18B20 ROMs must differ")
endif()
