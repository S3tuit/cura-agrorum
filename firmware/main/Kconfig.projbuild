menu "Device Configuration"

    config CURA_SOIL_SENSOR_ID
        int "Soil sensor ID"
        range 0 65535
        default 1
        help
            Numeric identifier for the soil sensor on this device.

    config CURA_DS18B20_SENSOR_ID
        int "DS18B20 sensor ID"
        range 0 65535
        default 1
        help
            Numeric identifier for the DS18B20 sensor on this device.

    config CURA_ENV280_SENSOR_ID
        int "ENV280 sensor ID"
        range 0 65535
        default 1
        help
            Numeric identifier for the BME280 sensor on this device.

    config CURA_SOIL_ADC_GPIO
        int "Soil ADC GPIO"
        range 0 39
        default 34
        help
            GPIO that reads soil sensor voltage.

    choice CURA_SOIL_ADC_ATTEN
        prompt "Soil ADC attenuation"
        default CURA_SOIL_ADC_ATTEN_DB_12
        help
            ADC attenuation used for soil sensor voltage readings.

        config CURA_SOIL_ADC_ATTEN_DB_0
            bool "0 dB"
        config CURA_SOIL_ADC_ATTEN_DB_2_5
            bool "2.5 dB"
        config CURA_SOIL_ADC_ATTEN_DB_6
            bool "6 dB"
        config CURA_SOIL_ADC_ATTEN_DB_12
            bool "12 dB"
    endchoice

    config CURA_DS18B20_GPIO
        int "DS18B20 GPIO"
        range 0 39
        default 4
        help
            GPIO used for the 1-Wire bus.

    choice CURA_DS18B20_RESOLUTION
        prompt "DS18B20 resolution"
        default CURA_DS18B20_RESOLUTION_12B
        help
            DS18B20 temperature conversion resolution.

        config CURA_DS18B20_RESOLUTION_9B
            bool "9 bit"
        config CURA_DS18B20_RESOLUTION_10B
            bool "10 bit"
        config CURA_DS18B20_RESOLUTION_11B
            bool "11 bit"
        config CURA_DS18B20_RESOLUTION_12B
            bool "12 bit"
    endchoice

    choice CURA_ENV280_I2C_PORT
        prompt "ENV280 I2C port"
        default CURA_ENV280_I2C_PORT_0
        help
            ESP32 I2C controller used for BME280 communication.

        config CURA_ENV280_I2C_PORT_0
            bool "I2C_NUM_0"
        config CURA_ENV280_I2C_PORT_1
            bool "I2C_NUM_1"
    endchoice

    config CURA_ENV280_I2C_SDA_GPIO
        int "ENV280 I2C SDA GPIO"
        range 0 39
        default 21
        help
            GPIO used for I2C SDA.

    config CURA_ENV280_I2C_SCL_GPIO
        int "ENV280 I2C SCL GPIO"
        range 0 39
        default 22
        help
            GPIO used for I2C SCL.

    config CURA_ENV280_I2C_FREQ_HZ
        int "ENV280 I2C frequency in Hz"
        range 1 1000000
        default 100000
        help
            I2C clock frequency used for BME280 communication.

    config CURA_ENV280_I2C_ADDR
        hex "ENV280 I2C address"
        range 0x00 0x7f
        default 0x76
        help
            BME280 I2C address. 0x76 matches BMP280_I2C_ADDRESS_0.

    config CURA_SOIL_DRY_MV
        int "Soil dry calibration in mV"
        range 0 3300
        default 2180
        help
            Soil sensor voltage in air for the current calibration.

    config CURA_SOIL_WET_MV
        int "Soil wet calibration in mV"
        range 0 3300
        default 660
        help
            Soil sensor voltage in water for the current calibration.

endmenu

menu "WiFi Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) for the ESP32 to connect to.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA or WPA2) for the ESP32 to use.

    choice ESP_WIFI_SAE_MODE
        prompt "WPA3 SAE mode selection"
        default ESP_STATION_EXAMPLE_WPA3_SAE_PWE_BOTH
        help
            Select mode for SAE as Hunt and Peck, H2E or both.
        config ESP_STATION_EXAMPLE_WPA3_SAE_PWE_HUNT_AND_PECK
            bool "HUNT AND PECK"
        config ESP_STATION_EXAMPLE_WPA3_SAE_PWE_HASH_TO_ELEMENT
            bool "H2E"
            depends on ESP_WIFI_ENABLE_SAE_H2E
        config ESP_STATION_EXAMPLE_WPA3_SAE_PWE_BOTH
            bool "BOTH"
            depends on ESP_WIFI_ENABLE_SAE_H2E
    endchoice

    config ESP_WIFI_PW_ID
        string "PASSWORD IDENTIFIER"
        depends on ESP_STATION_EXAMPLE_WPA3_SAE_PWE_HASH_TO_ELEMENT || ESP_STATION_EXAMPLE_WPA3_SAE_PWE_BOTH
        default ""
        help
            Password identifier for SAE H2E.

    config ESP_MAXIMUM_RETRY
        int "Maximum retry"
        default 5
        help
            Maximum WiFi connection retries before failing.

    choice ESP_WIFI_SCAN_AUTH_MODE_THRESHOLD
        prompt "WiFi Scan auth mode threshold"
        default ESP_WIFI_AUTH_WPA2_PSK
        help
            The weakest auth mode accepted while connecting to the AP.

        config ESP_WIFI_AUTH_OPEN
            bool "OPEN"
        config ESP_WIFI_AUTH_WEP
            bool "WEP"
        config ESP_WIFI_AUTH_WPA_PSK
            bool "WPA PSK"
        config ESP_WIFI_AUTH_WPA2_PSK
            bool "WPA2 PSK"
        config ESP_WIFI_AUTH_WPA_WPA2_PSK
            bool "WPA/WPA2 PSK"
        config ESP_WIFI_AUTH_WPA3_PSK
            bool "WPA3 PSK"
        config ESP_WIFI_AUTH_WPA2_WPA3_PSK
            bool "WPA2/WPA3 PSK"
        config ESP_WIFI_AUTH_WAPI_PSK
            bool "WAPI PSK"
    endchoice

    config CURA_MDNS_SERVICE_TYPE
        string "Gateway mDNS service type"
        default "_cura-agrorum"
        help
            mDNS service type advertised by the laptop or Pi gateway.

    config CURA_MDNS_PROTO
        string "Gateway mDNS protocol"
        default "_tcp"
        help
            mDNS protocol advertised by the laptop or Pi gateway.

    config CURA_MDNS_QUERY_TIMEOUT_MS
        int "mDNS query timeout in milliseconds"
        default 3000
        help
            Time to wait for mDNS service or host responses.

    config CURA_MDNS_MAX_RESULTS
        int "Maximum mDNS results"
        default 4
        help
            Maximum number of mDNS service results to collect.

    config CURA_TCP_CONNECT_TIMEOUT_MS
        int "TCP connect timeout in milliseconds"
        default 3000
        help
            Time to wait while opening a TCP connection to the gateway.

    config CURA_TCP_SEND_TIMEOUT_MS
        int "TCP send timeout in milliseconds"
        default 3000
        help
            Time to wait while sending a TCP frame to the gateway.

    config CURA_TCP_READ_TIMEOUT_MS
        int "TCP read timeout in milliseconds"
        default 3000
        help
            Time to wait while reading a TCP frame from the gateway.

endmenu

menu "Debug Configuration"

    config CURA_PROFILE_ENABLED
        bool "Enable profiling logs"
        default n
        help
            Enables PROFILE_START() and PROFILE_MARK() timing logs for
            measuring firmware execution time while debugging.

endmenu
