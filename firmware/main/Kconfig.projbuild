menu "Device Configuration"

    config CURA_SOIL_ADC_GPIO
        int "Soil ADC GPIO"
        range 0 39
        default 34
        help
            GPIO that reads soil sensor voltage.

    choice CURA_SOIL_ADC_ATTEN
        prompt "Soil ADC attenuation"
        default CURA_SOIL_ADC_ATTEN_DB_12
        help
            ADC attenuation used for soil sensor voltage readings.

        config CURA_SOIL_ADC_ATTEN_DB_0
            bool "0 dB"
        config CURA_SOIL_ADC_ATTEN_DB_2_5
            bool "2.5 dB"
        config CURA_SOIL_ADC_ATTEN_DB_6
            bool "6 dB"
        config CURA_SOIL_ADC_ATTEN_DB_12
            bool "12 dB"
    endchoice

    config CURA_DS18B20_GPIO
        int "DS18B20 GPIO"
        range 0 39
        default 4
        help
            GPIO used for the 1-Wire bus.

    choice CURA_DS18B20_RESOLUTION
        prompt "DS18B20 resolution"
        default CURA_DS18B20_RESOLUTION_12B
        help
            DS18B20 temperature conversion resolution.

        config CURA_DS18B20_RESOLUTION_9B
            bool "9 bit"
        config CURA_DS18B20_RESOLUTION_10B
            bool "10 bit"
        config CURA_DS18B20_RESOLUTION_11B
            bool "11 bit"
        config CURA_DS18B20_RESOLUTION_12B
            bool "12 bit"
    endchoice

    choice CURA_ENV280_I2C_PORT
        prompt "ENV280 I2C port"
        default CURA_ENV280_I2C_PORT_0
        help
            ESP32 I2C controller used for BME280 communication.

        config CURA_ENV280_I2C_PORT_0
            bool "I2C_NUM_0"
        config CURA_ENV280_I2C_PORT_1
            bool "I2C_NUM_1"
    endchoice

    config CURA_ENV280_I2C_SDA_GPIO
        int "ENV280 I2C SDA GPIO"
        range 0 39
        default 21
        help
            GPIO used for I2C SDA.

    config CURA_ENV280_I2C_SCL_GPIO
        int "ENV280 I2C SCL GPIO"
        range 0 39
        default 22
        help
            GPIO used for I2C SCL.

    config CURA_ENV280_I2C_FREQ_HZ
        int "ENV280 I2C frequency in Hz"
        range 1 1000000
        default 100000
        help
            I2C clock frequency used for BME280 communication.

    config CURA_ENV280_I2C_ADDR
        hex "ENV280 I2C address"
        range 0x00 0x7f
        default 0x76
        help
            BME280 I2C address. 0x76 matches BMP280_I2C_ADDRESS_0.

endmenu

menu "WiFi Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "cura-field"
        help
            SSID (network name) for the ESP32 to connect to.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "cura-field-password"
        help
            WiFi password (WPA or WPA2) for the ESP32 to use.

    config ESP_MAXIMUM_RETRY
        int "Maximum retry"
        default 5
        help
            Maximum WiFi connection retries before failing.

    config CURA_GATEWAY_IPV4_ADDR
        string "Gateway IPv4 address"
        default "10.42.0.1"
        help
            Static IPv4 address of the laptop gateway on the field hotspot.

    config CURA_GATEWAY_PORT
        int "Gateway TCP port"
        range 1 65535
        default 18032
        help
            TCP port where the Cura Agrorum server listens.

    config CURA_SYNC_EVERY_N_BOOTS
        int "Try WiFi sync every N boots"
        range 1 2147483647
        default 10
        help
            Number of boots between WiFi sync attempts. Boot 0 is a sync boot,
            so resetting the node forces an immediate sync attempt.

    config CURA_WIFI_CONNECT_TIMEOUT_MS
        int "Total WiFi connection timeout in milliseconds"
        range 1000 60000
        default 8000
        help
            Maximum time to wait for the field hotspot association and DHCP.

    config CURA_TCP_CONNECT_TIMEOUT_MS
        int "TCP connect timeout in milliseconds"
        default 3000
        help
            Time to wait while opening a TCP connection to the gateway.

    config CURA_TCP_SEND_TIMEOUT_MS
        int "TCP send timeout in milliseconds"
        default 3000
        help
            Time to wait while sending a TCP frame to the gateway.

    config CURA_TCP_READ_TIMEOUT_MS
        int "TCP read timeout in milliseconds"
        default 3000
        help
            Time to wait while reading a TCP frame from the gateway.

endmenu

menu "Debug Configuration"

    config CURA_PROFILE_ENABLED
        bool "Enable profiling logs"
        default n
        help
            Enables PROFILE_START() and PROFILE_MARK() timing logs for
            measuring firmware execution time while debugging.

endmenu
